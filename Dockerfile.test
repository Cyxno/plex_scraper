# Dev/test image: run the suite with FUSE available
#   docker build -t plex-scraper-test -f Dockerfile.test .
#   docker run --rm --device=/dev/fuse --cap-add SYS_ADMIN \
#     -v $PWD:/app -w /app plex-scraper-test pytest -q
FROM python:3.12-slim-bookworm

RUN apt-get update \
    && apt-get install -y --no-install-recommends build-essential libfuse3-dev fuse3 pkg-config nodejs \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY requirements-dev.txt requirements.txt ./
RUN pip install --no-cache-dir -r requirements-dev.txt

ENV PYTHONPATH=/app/src PYTHONUNBUFFERED=1
