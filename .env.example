# ---- required ----
# TorBox API key (https://torbox.app -> Settings -> API Keys)
TORBOX_API_TOKEN=

# ---- resolver ----
RESOLVER_BIND=0.0.0.0:8282
# Host publishing is restricted to localhost in docker-compose.yml by default.
# Expose to LAN only if you understand the implications (there is no auth yet).
DEBUG=false
LOG_LEVEL=info

# Scraper base (Torrentio instance incl. provider config; keep debrid OFF so
# results contain infoHash+fileIdx instead of proxied URLs)
SCRAPER_TORRENTIO_BASE=https://torrentio.strem.fun/providers=yts,eztv,rarbg,1337x,thepiratebay,kickasstorrents,torrentgalaxy,magnetdl,itorrent

# ---- caches (seconds) ----
CACHE_CANDIDATES_TTL=1800
CACHE_CHECKCACHED_TTL=600
CACHE_LINK_TTL=9000
CACHE_BAD_TTL=1800
CACHE_BAD_TTL_MAX=21600

# ---- provider hygiene ----
TORBOX_TIMEOUT_CONNECT=10
TORBOX_TIMEOUT_READ=30
TORBOX_MAX_RETRIES=3
UPSTREAM_CONCURRENCY=8

# ---- vfs ----
VFS_MOUNTPOINT=/mnt/plex-scraper
RESOLVER_URL=http://resolver:8282
STREAM_READAHEAD_BYTES=8388608
